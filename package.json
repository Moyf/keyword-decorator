{
  "name": "keyword-decorator",
  "version": "0.3.3",
  "description": "An Obsidian plugin that decorates keyword matches in the editor",
  "main": "main.js",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:local": "pnpm run build && pnpm run copy-to-local",
    "build:local:set": "pnpm run build:local && pnpm run open-plugin-settings",
    "copy-to-local": "node scripts/copy-to-local.mjs",
    "open-plugin-settings": "node scripts/open-plugin-settings.mjs",
    "test": "node scripts/test.mjs",
    "version": "node scripts/version-bump.mjs",
    "changelog:u": "conventional-changelog -p angular -i CHANGELOG.md -s -u",
    "release:pre": "pnpm run build && pnpm run version && pnpm run changelog:u",
    "release:tag": "node scripts/release-tag.mjs",
    "lint:obsidian": "eslint \"src/**/*.ts\" \"manifest.json\" package.json scripts tests",
    "lint:css": "stylelint styles.css",
    "lint": "pnpm run lint:obsidian && pnpm run lint:css",
    "lint:fix": "pnpm run lint:obsidian -- --fix && pnpm run lint:css -- --fix"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/language": "https://github.com/lishid/cm-language",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@simonwep/pickr": "https://github.com/nothingislost/pickr/archive/a17739f7aa1871b44da778cbb79ae76dae77d839.tar.gz",
    "@types/node": "^16.11.6",
    "ajv": "^8.9.0",
    "codemirror": "^6.0.0",
    "codemirror6-themes": "^0.1.2",
    "conventional-changelog-cli": "^5.0.0",
    "esbuild": "0.13.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^16.4.0",
    "linkedom": "0.18.12",
    "monkey-around": "^2.2.0",
    "obsidian": "1.14.4",
    "regexp-match-indices": "^1.0.2",
    "style-mod": "^4.1.4",
    "stylelint": "^14.2.0",
    "stylelint-config-recommended": "^6.0.0",
    "stylelint-config-standard": "^24.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "typescript-json-schema": "^0.53.0"
  }
}
