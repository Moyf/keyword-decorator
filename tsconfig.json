{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "importHelpers": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ES2018"]
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ]
}
